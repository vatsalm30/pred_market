{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnipred",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [
    { "pattern": "www.omnipred.com", "custom_domain": true },
    { "pattern": "omnipred.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true },
  // Non-secret settings. Secrets are set with `wrangler secret put`.
  "vars": {
    "DEPLOY_ENV": "production",
    "DYNAMODB_TABLE": "omnipred",
    "OMNIPRED_AWS_REGION": "us-east-1",
    "ADMIN_EMAILS": "vatsalm30@gmail.com",
    "CF_ANALYTICS_ACCOUNT_ID": "7bc657daf676bbda28aa076228c1e75f",
    "CF_ANALYTICS_ZONE_ID": "702b12ed3f40e4fb8f3ffe51e3a18fa3",
    "CF_WEB_ANALYTICS_SITE_TAG": "48c923ee14df4c91902a71e5122e320e"
  }
}
